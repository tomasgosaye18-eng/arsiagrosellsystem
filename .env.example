# =========================================================
# ARSI AGRI-MANAGE (AAM)
# File    : .env.example
# Purpose : Environment variable template.
#           Copy this file to .env and fill in real values.
#           NEVER commit .env to version control.
# =========================================================

# ─── Application ─────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_NAME="Arsi Agri-Manage"
APP_URL=http://localhost/aam/app
APP_TIMEZONE=Africa/Addis_Ababa
APP_LOCALE=en
APP_VERSION=1.0.0

# ─── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=aam_db
DB_USERNAME=aam_app
DB_PASSWORD=your_strong_password_here
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ─── Session ──────────────────────────────────────────────
SESSION_LIFETIME=1800
SESSION_NAME=aam_session
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# ─── Security ─────────────────────────────────────────────
ENCRYPTION_KEY=generate_a_32_char_random_string_here
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# ─── Uploads ─────────────────────────────────────────────
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp,pdf

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_CHANNEL=file

# ─── Cache ───────────────────────────────────────────────
CACHE_DRIVER=file
CACHE_TTL=3600

# ─── Maintenance ─────────────────────────────────────────
MAINTENANCE_MODE=false
